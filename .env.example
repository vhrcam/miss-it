# Copy this to .env, which git ignores. infra/deploy.sh and the Fire TV app's
# build both read it.

# The shared secret the Fire TV app sends with every playback update.
# Make one with: openssl rand -hex 24
MISS_IT_DEVICE_KEY=

# Optional. A key for Amazon's direct Nova API (nova.amazon.com/dev-apis).
# When it's set, recaps use it instead of Bedrock, which helps while a new
# account's Bedrock quotas are still 0.
NOVA_API_KEY=

# Optional. Points the Fire TV app at a local server instead of AWS. From the
# Vega Virtual Device, the Mac is 10.0.2.2.
# MISS_IT_API_URL=http://10.0.2.2:8787
